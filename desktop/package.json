    "eslint": "9.39.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.4.0",
    "prettier": "3.2.5"
  }
